<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}" style="text-decoration: none; color: inherit;">
    <div style="display: flex; align-items: center; justify-content: center; gap: 12px;">
      <img
        src="https://github.com/{{ include.username }}.png"
        alt="{{ include.username }}"
        style="width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--global-divider-color);"
        onerror="this.style.display='none'"
      >
      <span style="font-size: 1.1rem; font-weight: 500;">{{ include.username }}</span>
    </div>
  </a>
</div>
