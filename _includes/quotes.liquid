<div class="quotes">
  {% if site.quotes != blank %}
    {% assign quotes_size = site.quotes | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.quotes.scrollable and quotes_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign quotes = site.quotes | reverse %}
        {% if include.limit and page.quotes.limit %}
          {% assign quotes_limit = page.quotes.limit %}
        {% else %}
          {% assign quotes_limit = quotes_size %}
        {% endif %}
        {% for item in quotes limit: quotes_limit %}
          <tr>
            <th scope="row" style="width: 20%; vertical-align: middle;">{{ item.date | date: '%b %d, %Y' }}</th>
            <td style="vertical-align: middle;">
              {% if item.inline %}
                <blockquote class="blockquote" style="margin-bottom: 0;">
                  {% assign quote_content = item.content | remove: '<p>' | remove: '</p>' | strip %}
                  {% comment %} Simple logic: split into lines, first line is quote, second line is author {% endcomment %}
                  {% assign lines = quote_content | newline_to_br | split: '<br />' %}
                  {% assign non_empty_lines = '' | split: '' %}
                  {% for line in lines %}
                    {% assign trimmed = line | strip %}
                    {% if trimmed != '' %}
                      {% assign non_empty_lines = non_empty_lines | push: trimmed %}
                    {% endif %}
                  {% endfor %}
                  {% if non_empty_lines.size >= 2 %}
                    {% comment %} Has at least 2 lines - first is quote, second is author {% endcomment %}
                    <p style="margin-bottom: 0.5rem;">{{ non_empty_lines[0] }}</p>
                    <footer class="blockquote-footer" style="margin-top: 0.5rem;">
                      <cite>{{ non_empty_lines[1] | strip }}</cite>
                    </footer>
                  {% elsif non_empty_lines.size == 1 %}
                    {% comment %} Only one line - display as is {% endcomment %}
                    <p style="margin-bottom: 0.5rem;">{{ non_empty_lines[0] }}</p>
                  {% else %}
                    {% comment %} Fallback: display content as is {% endcomment %}
                    {{ quote_content | emojify }}
                  {% endif %}
                </blockquote>
              {% else %}
                <a class="quote-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No quotes yet...</p>
  {% endif %}
</div>

